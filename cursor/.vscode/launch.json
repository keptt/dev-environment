{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node-terminal",
      "request": "launch",
      "name": "Launch Program",
      "command": "yarn dev",
      "skipFiles": ["<node_internals>/**"],
      "env": {
        "DEBUG": "knex:query"
      }
      // 	"TS_NODE_PROJECT": "./tsconfig.server.json"
      // }
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Run Test File",
      "console": "internalConsole",
      // "console": "integratedTerminal",
      // "internalConsoleOptions": "neverOpen",
      "outputCapture": "std",
      "sourceMaps": true,
      "internalConsoleOptions": "openOnSessionStart",
      "program": "${workspaceFolder}/node_modules/jest/bin/jest",
      "cwd": "${workspaceFolder}",
      // "outFiles": ["${workspaceFolder}/${relativeFileDirname}/**/*.js"],
      "args": ["--forceExit", "--runInBand", "${file}"],
      // "args": ["--detectOpenHandles", "--forceExit", "--runInBand", "${file}"],
      "runtimeArgs": ["--preserve-symlinks", "--trace-warnings"],
      "resolveSourceMapLocations": [
        "${workspaceFolder}/**",
        "!**/node_modules/**"
      ],
      "outFiles": [
        "${workspaceFolder}/.next/server/**/*.js",
        "${workspaceFolder}/node_modules/**/*.js"
      ]
    },
    {
      "name": "Launch Program pool",
      "type": "pwa-node",
      "request": "launch",
      "program": "${workspaceFolder}/trial-pool/dist/main.js", // Adjust the entry point
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "build trial-pool",
      "outFiles": ["${workspaceFolder}trial-pool/dist/**/*.js"],
      "sourceMaps": true,
      "runtimeArgs": [
        "--experimental-specifier-resolution=node" // Helps with ESM module resolution
      ],
      "resolveSourceMapLocations": [
        "${workspaceFolder}/trial-pool/dist/**/*.js.map",
        "${workspaceFolder}trial-poo/src/**/*.ts"
      ],
      "env": {}
    },
    {
      "name": "pool mock",
      "type": "pwa-node",
      "request": "launch",
      "cwd": "${workspaceFolder}/trial-pool",
      "program": "${workspaceFolder}/trial-pool/dist-manual/tests/manual/initiator.js", // Adjust the entry point
      "preLaunchTask": "build trial-pool:mock",
      "outFiles": ["${workspaceFolder}/trial-pool/dist-manual/tests/**/*.js"],
      "sourceMaps": true,
      "runtimeArgs": [
        "--experimental-specifier-resolution=node" // Helps with ESM module resolution
      ],
      "resolveSourceMapLocations": [
        "${workspaceFolder}/trial-pool/dist-manual/**/*.js.map",
        "${workspaceFolder}/trial-pool/tests/manual/**/*.ts",
        "${workspaceFolder}/trial-pool/src/**/*.ts"
      ],
      "env": {}
    }
  ]
}
